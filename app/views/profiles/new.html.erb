
<div class="max-w-lg mx-auto bg-white p-6 rounded-lg shadow-lg">
  <h1 class="text-3xl font-bold mb-6 text-center">Create Your CV Profile</h1>
  <%= form_with url: profile_path, method: :get, class: "space-y-4" do %>
    <div>
      <label for="name" class="block text-sm font-semibold">Name</label>
      <%= text_field_tag :name, nil, class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400", required: true %>
    </div>

    <div>
      <label for="summary" class="block text-sm font-semibold">Summary</label>
      <%= text_field_tag :summary, nil, class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400", required: true %>
    </div>

    <div>
      <label for="expertise" class="block text-sm font-semibold">Expertise</label>
      <%= text_field_tag :expertise, nil, class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400", required: true %>
    </div>

    <div>
      <label for="about" class="block text-sm font-semibold">About</label>
      <%= text_area_tag :about, nil, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400", required: true %>
    </div>

    <div class="text-center">
      <%= submit_tag "Generate Profile", class: "bg-blue-500 text-white px-6 py-2 rounded-md hover:bg-blue-600 focus:outline-none" %>
    </div>
  <% end %>
</div>

<header class="bg-gradient-to-r from-purple-400 via-pink-500 to-red-500 fixed top-0 w-full z-50 p-6 lg:p-8 shadow-md flex flex-wrap items-center justify-between">
  <div class="flex items-center space-x-4">
    <h1 href="#home" class="text-2xl lg:text-4xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-green-800 via-pink-500 to-purple-500 logo cursor-pointer">CV | Generator</h1>
  </div>
  <nav class="text-lg lg:text-2xl text-black font-bold flex flex-wrap justify-center">
    <a href="#home" class="nav-link hover:text-purple-400 mx-4 lg:mx-10">Home</a>
    <a href="#about" class="nav-link hover:text-purple-400 mx-4 lg:mx-10">About</a>
    <a href="#services" class="nav-link hover:text-purple-400 mx-4 lg:mx-10">Services</a>
    <a href="#contactus" class="nav-link hover:text-purple-400 mx-4 lg:mx-10">Contact Us</a>
  </nav>
</header>

<%= form_with url: profiles_path, local: true, html: { multipart: true, class: "w-full flex flex-col lg:flex-row" } do |form| %>
<div class="container mx-auto flex flex-col lg:flex-row mt-48 px-4 lg:px-0">
  <!-- Shared Form Across Both Sections -->
<!--%#= form_with model: @profile, local: true, html: { multipart: true, class: "w-full flex flex-col lg:flex-row" } do |form| %>-->
    <!-- Left Section -->
    <div class="left-section flex-1 p-4 lg:p-6 bg-gradient-to-r from-green-300 to-blue-300 border-r border-gray-300 transform transition-transform duration-700 hover:scale-105" id="browse">
      <h2 class="text-lg lg:text-xl font-semibold mb-4">Smart File Upload</h2>
      <div class="relative border-2 border-dashed border-gray-400 rounded-lg p-4 lg:p-6 text-center file-upload-animation" id="drop-zone">
        <%= form.file_field :file, class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer", required: true, id: "file-upload",accept: ".png,.jpeg,.jpg,.pdf,.doc,.docx"%>
        <div class="flex flex-col items-center justify-center space-y-2 pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 lg:h-10 w-8 lg:w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16l4-4m0 0l4 4m-4-4v12m9-16a9 9 0 11-6.507 15.207M15 10l-4 4m0 0l-4-4m4 4V3" />
          </svg>
          <p class="text-sm lg:text-base text-gray-500">Drag & drop your file here, or <span class="text-blue-500 underline">browse</span></p>
          <p class="text-xs lg:text-sm text-gray-400">Supported formats:.png,.jpeg,.jpg,.pdf,.doc,.docx</p>
        </div>
      </div>
      <!-- File Preview Section -->
      <div id="file-preview" class="mt-4 hidden border border-gray-300 rounded-lg p-4 bg-white">
        <p class="text-gray-700 font-semibold">Uploaded File:</p>
        <p id="file-name" class="text-gray-600 text-sm"></p>
      </div>
    </div>
    <!-- Right Section -->
    <div class="right-section flex-1 p-6 bg-gradient-to-r from-green-400 via-pink-500 to-purple-500 transform transition-transform duration-700 hover:scale-105" id="form">
      <h2 class="text-xl font-semibold">Submit Your Details</h2>
      <div class="mt-4 space-y-4">
        <div class="relative">
          <%= form.text_field :name, placeholder: "Your Name", required: true, class: "animated-input w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <span class="absolute right-3 top-3 text-gray-400">✎</span>
        </div>

        <div class="relative">
          <%= form.text_area :summary, rows: 3, placeholder: "Professional Summary", required: true, class: "animated-input w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <span class="absolute right-3 top-3 text-gray-400">✎</span>
        </div>

        <div class="relative">
          <%= form.text_field :expertise, placeholder: "Skills :html,css,python", required: true, class: "animated-input w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <span class="absolute right-3 top-3 text-gray-400">✎</span>
        </div>

        <div class="relative">
          <%= form.text_field :experience, placeholder: "Experience: 2.5 years,8 months", required: true, class: "animated-input w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <span class="absolute right-3 top-3 text-gray-400">✎</span>
        </div>

        <div class="relative">
          <%= form.hidden_field :dynamicdata, id: "dynamic-data-field", class: "w-full p-2 border border-gray-300 rounded-md" %>
        </div>

        <div id="dynamic-fields" class="space-y-4">
          <!-- Dynamic fields will be added here -->
        </div>

        <div class="text-right">
          <button
            type="button"
            id="add-field"
            class="text-white bg-green-500 hover:bg-green-600 px-4 py-2 rounded-md"
          >
            + Add Field
          </button>
        </div>



      </div>
    </div>

  <%= form.submit "Generate Profile", class: "w-full bg-gradient-to-r from-purple-500 to-blue-500 text-white p-2 rounded-md hover:bg-gradient-to-l transition-transform transform hover:scale-105" %>

</div>

<% end %>

</div>
<div>
  <div class="hidden lg:block">
    <!-- Floating items -->
    <div class="floating-item item1 max-w-20 lg:max-w-28">
      <img src="/assets/item1.png" alt="Item 1" class="rounded-full shadow-lg">
    </div>
    <div class="floating-item item2 max-w-20 lg:max-w-28">
      <img src="/assets/item2.png" alt="Item 2" class="rounded-full shadow-lg">
    </div>
    <div class="floating-item item3 max-w-20 lg:max-w-28">
      <img src="/assets/item3.png" alt="Item 3" class="rounded-full shadow-lg">
    </div>
  </div>

</div>